# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Auth (required — no default, app refuses to start without these)
JWT_SECRET=
JWT_EXPIRES_IN=24h
JWT_ISSUER=filebot-webui

# Plex
PLEX_CLIENT_ID=
PLEX_REDIRECT_URL=http://localhost:8080/auth/plex/forward
TMDB_ACCESS_TOKEN=
ANIDB_CLIENT=
ANIDB_CLIENTVER=
ANIDB_PROTOVER=1
ANIDB_BASE_URL=http://api.anidb.net:9001/httpapi
# Optional local AniDB titles XML for title->AID lookup (e.g. anime-titles.xml)
ANIDB_TITLES_FILE=
# Optional source URL for AniDB titles XML (used when auto-refresh enabled)
ANIDB_TITLES_URL=https://anidb.net/api/anime-titles.xml.gz
# Refresh ANIDB_TITLES_FILE at startup (true/false)
ANIDB_REFRESH_TITLES_ON_START=false
# Background scheduler: fetches titles every ANIDB_SCHEDULER_INTERVAL but only
# downloads remotely when file is older than ANIDB_MIN_FETCH_INTERVAL (AniDB policy: ≥24h)
ANIDB_SCHEDULER_ENABLED=false
ANIDB_SCHEDULER_INTERVAL=12h
ANIDB_MIN_FETCH_INTERVAL=24h

# Deluge
DELUGE_HOST=
DELUGE_PORT=8112
DELUGE_USERNAME=
DELUGE_PASSWORD=

# Media / FileBot
MEDIA_ROOT=

# Database
DB_TYPE=sqlite
DB_DATABASE=./data/app.db
# PostgreSQL alternative:
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=
# DB_PASSWORD=
# DB_SSL_MODE=disable

# Logging
LOG_LEVEL=info
DEBUG=false
# DEV_MODE bypasses auth and mocks Deluge/Plex — metadata resolvers (TMDB, AniDB) stay real
DEV_MODE=false
