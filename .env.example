# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Auth (required — no default, app refuses to start without these)
JWT_SECRET=
JWT_EXPIRES_IN=24h
JWT_ISSUER=filebot-webui

# Plex
PLEX_CLIENT_ID=
PLEX_REDIRECT_URL=http://localhost:8080/auth/plex/forward
TMDB_ACCESS_TOKEN=

# Deluge
DELUGE_HOST=
DELUGE_PORT=8112
DELUGE_USERNAME=
DELUGE_PASSWORD=

# FileBot (required)
MEDIA_ROOT=
FILEBOT_PATH=filebot
FILEBOT_LICENSE_PATH=

# Database
DB_TYPE=sqlite
DB_DATABASE=./data/app.db
# PostgreSQL alternative:
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=
# DB_PASSWORD=
# DB_SSL_MODE=disable

# Logging
LOG_LEVEL=info
DEBUG=false
